# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Vertex AI, via an application-default login plus a project-scoped regional endpoint.
# See content/bin/vertex.py for why express-mode API keys no longer work.
#
#     gcloud auth application-default login
#
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# Legacy express-mode key. Kept because vertex.available() still falls back to it,
# but the ADC path above is the one that works.
AGENT_GCP_KEY=

# Optional: OpenAI, if you run generate_stills.py --provider openai
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Backblaze B2, read by genblaze-s3's S3StorageBackend.for_backblaze().
# B2_KEY_ID / B2_APP_KEY are the names genblaze-s3 looks for — do not rename them.
# Check your setup without spending anything:  bin/blaze.py check
# ---------------------------------------------------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=remixkit
B2_REGION=us-west-004
# Optional. Defaults to https://f004.backblazeb2.com/file/<bucket> derived from region.
B2_PUBLIC_URL_BASE=
