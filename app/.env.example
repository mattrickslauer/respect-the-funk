# Copy to app/.env and fill in. .env is gitignored — never commit real values.
#
# Everything here is optional. With none of it set the console runs on a laptop with
# local storage, mocked generation, an inline queue, and no login — and says so in a
# banner on every page. Each variable below moves one axis to the real thing.

# ---------------------------------------------------------------- sign-in
# `none` (default) = AnonymousAuth, every caller is the default tenant, no login page.
# `otp`            = email a six-digit code, exchange it for a signed session.
RK_AUTH_BACKEND=none

# This IS the user table. Comma-separated; there is no registration. An address not on
# this list is refused at request time, at verify time, and on every session read — so
# removing someone ends their session at their next request.
RK_ALLOWED_EMAILS=

# Signs sessions and hashes OTP codes. Generate with:
#     python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave empty on a laptop and a random one is used per process, which logs everyone out
# on restart. RK_REQUIRE_AUTH=true refuses to start rather than doing that.
RK_SESSION_SECRET=

# ---------------------------------------------------------------- mail
# `console` (default) logs the code instead of sending it, so the flow is completable
# with no credentials. In RK_ENV=dev the code is also returned to the caller — both
# conditions are required, because either alone would be an auth bypass.
RK_MAIL_BACKEND=console

# ZeptoMail. The SMTP password and the "send mail token" are the same secret; the same
# value would also work against the HTTP API as `Authorization: Zoho-enczapikey <token>`.
RK_ZEPTOMAIL_TOKEN=
# Must be a verified sender on a domain with SPF/DKIM published, or codes land in spam —
# which is indistinguishable from a broken login.
RK_MAIL_FROM=rtp@agfarms.dev
RK_MAIL_FROM_NAME=Respect the Funk

# ---------------------------------------------------------------- backends
# RK_STORAGE_BACKEND=b2
# RK_B2_BUCKET=
# RK_B2_KEY_ID=
# RK_B2_APP_KEY=
# RK_B2_REGION=

# RK_GENERATOR_BACKEND=genblaze
# Genblaze reads these unprefixed, straight from the environment.
# GMI_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
#
# Pin a vendor per modality: gmicloud | openai | google | elevenlabs. Empty is the
# preference order in adapters/providers.VENDOR_ORDER (GMI, then OpenAI, then Google;
# OpenAI ahead of Google because Vertex needs Application Default Credentials, which do
# not exist inside Lambda or a Fargate task).
#
# This exists so that moving a modality off a misbehaving provider is a deploy-time
# setting rather than a code change — on 2026-07-31 GMI's seedance-2 failed twice and
# billed for output it never produced, and video moved to Sora without an edit.
# RK_VIDEO_PROVIDER=openai
# RK_IMAGE_PROVIDER=
# RK_AUDIO_PROVIDER=
#
# Refuse any single run whose pre-flight estimate exceeds this, in cents. 0 disables it.
# Genblaze ships no spend guardrail of its own and a failed step is still a billed step,
# so this is the only thing standing between a bad brief and a surprise invoice. Prices
# come from adapters/pricing, which is registered into Genblaze's own ModelRegistry so
# the estimate and the ledger cannot disagree.
# RK_MAX_RUN_CENTS=500

# RK_QUEUE_BACKEND=sqs
# RK_SQS_QUEUE_URL=
# RK_BATCH_JOB_QUEUE=
# RK_BATCH_JOB_DEFINITION=

# Measuring an uploaded master — tempo, drop, sections. `auto` (the default) uses numpy if
# it is installed and refuses with the missing piece named if it is not; there is no mock,
# because a fabricated BPM is a float nothing downstream could tell from a real one.
#   pip install -e '.[audio]'     and ffmpeg on PATH for anything but a WAV
# `none` switches it off in a process that should not be doing DSP at all.
# RK_ANALYSIS_BACKEND=none
# RK_ANALYSIS_WINDOW_S=600

# ---------------------------------------------------------------- secrets from SSM
# Rather than pasting the keys above, name an SSM path and they are fetched at startup —
# the same mechanism production uses, so a laptop and a deployment read credentials the
# same way and there is no second code path to keep honest.
#
# RK_AWS_PROFILE matters on a laptop: without it boto3 falls back to `default`, and a
# stale default profile fails with an authentication error that never says which
# identity it tried. In a deployment leave it empty — the execution role has no profile.
# RK_SSM_PATH=/remixkit/prod
# RK_AWS_PROFILE=respect-the-funk
