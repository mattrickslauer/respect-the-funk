{
  "id": "kit",
  "title": "Kit",
  "route": "/console/kits/{kit_id}",
  "entity": "Kit",
  "nav": {
    "group": "catalogue",
    "order": 2
  },
  "purpose": "One generated pack: what it cost, what it produced, whether its provenance holds, and whether a human has cleared it.",
  "body": {
    "type": "col",
    "gap": "loose",
    "children": [
      {
        "type": "row",
        "weights": [
          3,
          2
        ],
        "gap": "base",
        "children": [
          {
            "type": "region",
            "title": "Kit",
            "children": [
              {
                "type": "detail",
                "entity": "Kit",
                "fields": [
                  "name",
                  "status",
                  "run_id",
                  "created_at",
                  "updated_at"
                ],
                "columns": 2
              },
              {
                "type": "detail",
                "entity": "Kit",
                "fields": [
                  "brief"
                ],
                "columns": 1,
                "note": "The brief the run was built from \u2014 shot count, identity version, requested modalities."
              }
            ]
          },
          {
            "type": "region",
            "title": "Review",
            "hint": "A label does not auto-publish AI content about its own artists.",
            "children": [
              {
                "type": "detail",
                "entity": "Kit",
                "fields": [
                  "approval"
                ],
                "columns": 1
              },
              {
                "type": "actions",
                "align": "left",
                "items": [
                  {
                    "label": "Approve",
                    "kind": "primary"
                  },
                  {
                    "label": "Send back to draft",
                    "kind": "secondary"
                  },
                  {
                    "label": "Publish",
                    "kind": "primary"
                  }
                ]
              },
              {
                "type": "text",
                "lines": 2,
                "label": "Reviewer note"
              }
            ]
          }
        ]
      },
      {
        "type": "region",
        "title": "Progress",
        "hint": "Generation is minutes. This surface is polled, not streamed.",
        "children": [
          {
            "type": "repeat",
            "of": "Asset",
            "count": 4,
            "children": [
              {
                "type": "row",
                "weights": [
                  1,
                  3,
                  1
                ],
                "children": [
                  {
                    "type": "text",
                    "lines": 1,
                    "label": "modality"
                  },
                  {
                    "type": "text",
                    "lines": 1,
                    "label": "step state"
                  },
                  {
                    "type": "text",
                    "lines": 1,
                    "label": "cost"
                  }
                ]
              }
            ]
          },
          {
            "type": "banner",
            "tone": "gap",
            "source": "Failure state \u2014 error text from the run, shown in full"
          }
        ]
      },
      {
        "type": "region",
        "title": "Assets",
        "hint": "Vertical loops and cards. Each downloadable with provenance embedded in the file.",
        "children": [
          {
            "type": "gallery",
            "count": 6,
            "ratio": "9:16",
            "caption": "Generated asset \u2014 provider, model, content hash"
          },
          {
            "type": "table",
            "entity": "Asset",
            "fields": [
              "modality",
              "provider",
              "model",
              "sha256",
              "cost_cents"
            ],
            "rows": 5
          },
          {
            "type": "actions",
            "items": [
              {
                "label": "Download all",
                "kind": "primary"
              },
              {
                "label": "Copy manifest",
                "kind": "secondary"
              }
            ]
          }
        ]
      },
      {
        "type": "region",
        "title": "Cost",
        "hint": "What the run actually cost, per step and in total.",
        "children": [
          {
            "type": "stats",
            "items": [
              {
                "label": "Total",
                "source": "Kit.total_cost_cents"
              },
              {
                "label": "Per delivered asset",
                "source": "total \u00f7 count of Asset"
              },
              {
                "label": "Estimated before run",
                "source": "Kit.brief.estimate_cents"
              },
              {
                "label": "Variance",
                "source": "actual \u2212 estimate"
              }
            ]
          }
        ]
      },
      {
        "type": "region",
        "title": "Provenance",
        "children": [
          {
            "type": "detail",
            "entity": "Kit",
            "fields": [
              "manifest_key",
              "manifest_verified",
              "parent_run_id"
            ],
            "columns": 2
          },
          {
            "type": "actions",
            "items": [
              {
                "label": "Open in verifier",
                "kind": "secondary"
              }
            ]
          }
        ]
      }
    ]
  }
}
