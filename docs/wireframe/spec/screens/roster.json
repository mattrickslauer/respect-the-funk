{
  "id": "roster",
  "title": "Roster",
  "route": "/console",
  "entity": "Artist",
  "nav": {
    "group": "roster",
    "order": 1
  },
  "purpose": "The landing surface. Who is on the roster, and which of them are ready to generate.",
  "body": {
    "type": "col",
    "gap": "loose",
    "children": [
      {
        "type": "banner",
        "tone": "info",
        "source": "Deployment descriptor \u2014 which storage, generator and queue are live",
        "note": "Always visible. A console running on mock providers must never look identical to one running live."
      },
      {
        "type": "stats",
        "items": [
          {
            "label": "Artists",
            "source": "count of Artist"
          },
          {
            "label": "Cleared to generate",
            "source": "count where consent.granted"
          },
          {
            "label": "Songs measured",
            "source": "count where Song.bpm is set"
          },
          {
            "label": "Kits awaiting review",
            "source": "count where Kit.approval is draft"
          }
        ],
        "note": "Summary before detail. Each tile names its own derivation so the number is auditable."
      },
      {
        "type": "region",
        "title": "Roster",
        "hint": "Sorted by name. Paginated \u2014 the collection is not assumed to be small.",
        "children": [
          {
            "type": "filters",
            "entity": "Artist",
            "fields": [
              "name",
              "approval"
            ],
            "note": "Filtering belongs server-side. Scanning the whole collection to filter in the client is the failure this screen must not repeat."
          },
          {
            "type": "table",
            "entity": "Artist",
            "fields": [
              "name",
              "slug",
              "consent",
              "approval",
              "updated_at"
            ],
            "rows": 6,
            "sortable": true
          },
          {
            "type": "empty",
            "message": "No artists yet.",
            "action": "Register the first artist"
          }
        ]
      },
      {
        "type": "region",
        "title": "Register an artist",
        "children": [
          {
            "type": "form",
            "entity": "Artist",
            "fields": [
              "name",
              "bio",
              "links"
            ],
            "submit": "Register",
            "layout": "stacked",
            "note": "Identity, consent and songs are separate steps. Registration stays short so it is never the thing that blocks onboarding."
          }
        ]
      }
    ]
  }
}
