{
  "id": "verify",
  "title": "Verifier",
  "route": "/console/verify",
  "entity": "Asset",
  "nav": {
    "group": "provenance",
    "order": 1
  },
  "purpose": "Drop in a file, read back what made it. Nothing is looked up \u2014 the answer comes out of the bytes.",
  "body": {
    "type": "col",
    "gap": "loose",
    "children": [
      {
        "type": "region",
        "title": "Check a file",
        "hint": "Accepts a media file with an embedded manifest, or a manifest document on its own.",
        "children": [
          {
            "type": "media",
            "kind": "image",
            "ratio": "16:5",
            "caption": "Drop target"
          },
          {
            "type": "actions",
            "items": [
              {
                "label": "Choose file",
                "kind": "primary"
              }
            ]
          }
        ]
      },
      {
        "type": "region",
        "title": "Result",
        "children": [
          {
            "type": "row",
            "weights": [
              1,
              2
            ],
            "children": [
              {
                "type": "banner",
                "tone": "ok",
                "source": "Verdict \u2014 verified, unverified, or no provenance found"
              },
              {
                "type": "text",
                "lines": 2,
                "label": "What the verdict means, in plain terms"
              }
            ]
          },
          {
            "type": "detail",
            "entity": "Kit",
            "fields": [
              "run_id",
              "manifest_key"
            ],
            "columns": 2
          },
          {
            "type": "table",
            "entity": "Asset",
            "fields": [
              "modality",
              "provider",
              "model",
              "prompt"
            ],
            "rows": 4,
            "note": "One row per step in the run. This is the disclosure the file carries about itself."
          }
        ]
      },
      {
        "type": "region",
        "title": "Absent provenance",
        "hint": "The common case for a file that did not come from here. It is a finding, not an error.",
        "children": [
          {
            "type": "empty",
            "message": "No manifest found. This file carries no provenance.",
            "action": "Check another file"
          }
        ]
      }
    ]
  }
}
