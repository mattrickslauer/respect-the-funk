{
  "name": "rtf-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The agentic console. Three surfaces over the objects the Jinja console already serves.",
  "scripts": {
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "check-tokens": "node scripts/sync-tokens.mjs --check",
    "predev": "npm run sync-tokens",
    "dev": "vite",
    "prebuild": "npm run sync-tokens",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
